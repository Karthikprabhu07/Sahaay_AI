        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(i => i.json).filter(j => j && j.scheme_id);\nconst profile = $('Parse Profile').first().json.profile;\nconst eligible = results.filter(r => r.eligible);\nlet reply;\nif (eligible.length === 0) {\n  reply = 'Based on the details you shared, I could not confirm eligibility for any scheme right now.' + (results.length ? ' I reviewed ' + results.length + ' candidate scheme(s).' : '');\n} else {\n  reply = 'You may be eligible for: ' + eligible.map(r => r.scheme_id).join(', ') + '. ' + eligible.map(r => r.scheme_id + ' \u2014 ' + r.explanation).join(' ');\n}\nreturn [{ json: { reply, extracted_profile: profile, matches: results } }];"
      },
