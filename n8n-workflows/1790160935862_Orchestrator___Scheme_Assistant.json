        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', temperature: 0, messages: [ { role: 'system', content: 'You extract an applicant profile for Indian government welfare schemes from the user message. Reply ONLY with a JSON object with keys state (string), occupation (string), income (number, annual family income in INR), need (string \u2014 MUST be exactly one of: education, welfare, healthcare, financial_inclusion \u2014 whichever is the closest match to what the user is asking about; do not invent other values; if genuinely unclear, use welfare). If a value is not stated, use an empty string, or 0 for income.' }, { role: 'user', content: String(($json.body || {}).message || '') } ], response_format: { type: 'json_object' } }) }}",
        "options": {}
      },
      "id": "4528a69c-e430-40c6-9a88-cbd85e739456",
      "name": "Groq Extract Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let parsed = null;\ntry {\n  const content = $json.choices && $json.choices[0] && $json.choices[0].message ? $json.choices[0].message.content : null;\n  parsed = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  parsed = null;\n}\nconst hasSomething = parsed && (parsed.state || parsed.occupation || Number(parsed.income) > 0 || parsed.need);\nif (!hasSomething) {\n  return { json: { parse_ok: false, profile: null, clarify: 'To find the right schemes, could you tell me your state, your occupation, your approximate annual family income, and what kind of help you are looking for?' } };\n}\nconst profile = {\n  state: parsed.state || '',\n  occupation: parsed.occupation || '',\n  income: Number(parsed.income) || 0,\n  need: parsed.need || '',\n};\nreturn { json: { parse_ok: true, profile } };"
      },
      "id": "86fd05b2-bfd8-4c8f-9029-27cf73db79a1",
